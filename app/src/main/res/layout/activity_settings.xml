<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Section A: Battery Floor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Battery Floor"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/batteryFloorLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable BingeLock below: 15%"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/batterySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="45"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="20dp" />

        <!-- Section B: Face-down Detection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Face-down Detection"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/faceDownSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pause when face-down"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/faceDownDurationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/faceDownDurationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pause after: 10 seconds"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/faceDownDurationSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="55"
                android:layout_marginBottom="20dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="20dp" />

        <!-- Section C: Target Apps -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target Apps"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/ytCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YouTube (com.google.android.youtube)"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/ytMorpheCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YouTube Morphe (app.morphe.android.youtube)"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="20dp" />

        <!-- Section D: Advanced -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced (edit with care)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BingeLock dismisses a YouTube prompt when it finds one of these prompt phrases on screen, then clicks the first matching action button."
            android:textColor="#999999"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prompt phrases (one per line)"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/promptPhrasesEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="6"
            android:gravity="top|start"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="#1A1A1A"
            android:padding="8dp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Action buttons (one per line)"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/actionButtonsEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top|start"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="#1A1A1A"
            android:padding="8dp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="20dp" />

        <!-- Bottom Buttons -->
        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Done"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset to defaults" />

    </LinearLayout>
</ScrollView>
